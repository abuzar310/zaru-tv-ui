<?xml version="1.0" encoding="utf-8"?>
<!-- One vibe dock cell: an equal 146dp cell, the app's white logo sized by its visual weight in an 85dp row, and
     G, its name underneath, shown while focused. Focus grows the logo 1.16x (VibeHomeActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="146dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/vibeLogoBox"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:clipChildren="false"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/vibeLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <!-- No mark and no usable banner: the app's name stands in as a wordmark. -->
        <TextView
            android:id="@+id/vibeWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxWidth="130dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/vibeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:singleLine="true"
        android:textColor="#F2FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/outfit_medium" />
</LinearLayout>
