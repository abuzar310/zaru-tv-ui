<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center's Now Playing card (NowPlayingCard): artwork, title, the line under it, what OK will do and a
     progress line. Hidden until something plays. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ccNow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:background="@drawable/cc_tile_bg"
    android:paddingStart="10dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:clickable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/ccNowArt"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/cc_now_art_bg"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/ccNowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/cc_tile_text"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium" />

            <TextView
                android:id="@+id/ccNowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:duplicateParentState="true"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/cc_tile_sub"
                android:textSize="10sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ccNowState"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:duplicateParentState="true"
            android:tint="@color/cc_tile_text"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ccNowBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/cc_now_bar"
        android:backgroundTint="@color/cc_now_track"
        android:duplicateParentState="true"
        android:visibility="gone">

        <View
            android:id="@+id/ccNowFill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cc_now_bar"
            android:backgroundTint="@color/cc_tile_text"
            android:duplicateParentState="true" />
    </FrameLayout>
</LinearLayout>
