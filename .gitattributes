# Normalise line endings so diffs stay clean across machines.
* text=auto eol=lf

# Shell scripts must stay LF.
*.sh text eol=lf

# Binary assets — never touch line endings or try to diff them.
*.mp4 binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.pem binary
*.jar binary
*.keystore binary
